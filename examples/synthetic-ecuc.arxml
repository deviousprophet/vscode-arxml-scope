<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00048.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>Synthetic</SHORT-NAME>
      <ELEMENTS>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>SampleModule</SHORT-NAME>
          <DEFINITION-REF DEST="ECUC-MODULE-DEF">/Synthetic/SampleModuleDef</DEFINITION-REF>
          <IMPLEMENTATION-CONFIG-VARIANT>VARIANT-PRE-COMPILE</IMPLEMENTATION-CONFIG-VARIANT>
          <ANNOTATIONS>
            <ANNOTATION>
              <LABEL>
                <L-4 L="EN">Sample</L-4>
              </LABEL>
              <ANNOTATION-TEXT>
                <VERBATIM>
                  <L-5 L="EN">Synthetic module used by the ARXML Scope examples.</L-5>
                </VERBATIM>
              </ANNOTATION-TEXT>
            </ANNOTATION>
          </ANNOTATIONS>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>Main</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/Synthetic/SampleModuleDef/Main</DEFINITION-REF>
              <ANNOTATIONS>
                <ANNOTATION>
                  <ANNOTATION-TEXT>
                    <VERBATIM>
                      <L-5 L="EN">Main settings for the synthetic sample.</L-5>
                    </VERBATIM>
                  </ANNOTATION-TEXT>
                </ANNOTATION>
              </ANNOTATIONS>
              <PARAMETER-VALUES>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/Synthetic/SampleModuleDef/Main/TimeoutSeconds</DEFINITION-REF>
                  <VALUE>42</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-FLOAT-PARAM-DEF">/Synthetic/SampleModuleDef/Main/SampleRate</DEFINITION-REF>
                  <VALUE>3.5</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-BOOLEAN-PARAM-DEF">/Synthetic/SampleModuleDef/Main/Enabled</DEFINITION-REF>
                  <VALUE>true</VALUE>
                </ECUC-NUMERICAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-STRING-PARAM-DEF">/Synthetic/SampleModuleDef/Main/Greeting</DEFINITION-REF>
                  <VALUE>hello</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-ENUMERATION-PARAM-DEF">/Synthetic/SampleModuleDef/Main/Mode</DEFINITION-REF>
                  <VALUE>FAST</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-FUNCTION-NAME-DEF">/Synthetic/SampleModuleDef/Main/EntryPoint</DEFINITION-REF>
                  <VALUE>Sample_Init</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF DEST="ECUC-LINKER-SYMBOL-DEF">/Synthetic/SampleModuleDef/Main/BufferSymbol</DEFINITION-REF>
                  <VALUE>sample_buffer</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
              </PARAMETER-VALUES>
              <REFERENCE-VALUES>
                <ECUC-REFERENCE-VALUE>
                  <DEFINITION-REF DEST="ECUC-REFERENCE-DEF">/Synthetic/SampleModuleDef/Main/PeerRef</DEFINITION-REF>
                  <VALUE-REF DEST="ECUC-CONTAINER-VALUE">/Synthetic/SampleModule/Main/Sub</VALUE-REF>
                </ECUC-REFERENCE-VALUE>
                <ECUC-INSTANCE-REFERENCE-VALUE>
                  <DEFINITION-REF DEST="ECUC-INSTANCE-REFERENCE-DEF">/Synthetic/SampleModuleDef/Main/PeerIref</DEFINITION-REF>
                  <VALUE-IREF>
                    <TARGET-REF DEST="ECUC-CONTAINER-VALUE">/Synthetic/SampleModule/Main/Sub</TARGET-REF>
                    <CONTEXT-ELEMENT-REF DEST="ECUC-CONTAINER-VALUE">/Synthetic/SampleModule/Main</CONTEXT-ELEMENT-REF>
                  </VALUE-IREF>
                </ECUC-INSTANCE-REFERENCE-VALUE>
              </REFERENCE-VALUES>
              <SUB-CONTAINERS>
                <ECUC-CONTAINER-VALUE>
                  <SHORT-NAME>Sub</SHORT-NAME>
                  <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/Synthetic/SampleModuleDef/Main/Sub</DEFINITION-REF>
                  <VARIATION-POINT>
                    <SW-SYSCOND>(SAMPLE_ENABLED == true)</SW-SYSCOND>
                  </VARIATION-POINT>
                  <PARAMETER-VALUES>
                    <ECUC-NUMERICAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/Synthetic/SampleModuleDef/Main/Sub/Retries</DEFINITION-REF>
                      <VALUE>3</VALUE>
                    </ECUC-NUMERICAL-PARAM-VALUE>
                    <ECUC-TEXTUAL-PARAM-VALUE>
                      <DEFINITION-REF DEST="ECUC-STRING-PARAM-DEF">/Synthetic/SampleModuleDef/Main/Sub/Label</DEFINITION-REF>
                      <VALUE>sub</VALUE>
                    </ECUC-TEXTUAL-PARAM-VALUE>
                  </PARAMETER-VALUES>
                </ECUC-CONTAINER-VALUE>
              </SUB-CONTAINERS>
            </ECUC-CONTAINER-VALUE>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>Empty</SHORT-NAME>
              <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/Synthetic/SampleModuleDef/Empty</DEFINITION-REF>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
