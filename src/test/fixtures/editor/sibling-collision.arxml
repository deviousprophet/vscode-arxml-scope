<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic fixture: sibling containers that share a SHORT-NAME (UX child design §13,
     R-UX13). Each twin holds a parameter with a distinct value, so a test can tell which
     one an id resolves to. Never a real customer file. -->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00048.xsd">
    <AR-PACKAGES>
        <AR-PACKAGE>
            <SHORT-NAME>Pkg</SHORT-NAME>
            <ELEMENTS>
                <ECUC-MODULE-CONFIGURATION-VALUES>
                    <SHORT-NAME>Mod</SHORT-NAME>
                    <DEFINITION-REF DEST="ECUC-MODULE-DEF">/Pkg/ModDefs/Mod</DEFINITION-REF>
                    <CONTAINERS>
                        <ECUC-CONTAINER-VALUE>
                            <SHORT-NAME>Twin</SHORT-NAME>
                            <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/Pkg/ModDefs/Mod/Twin</DEFINITION-REF>
                            <PARAMETER-VALUES>
                                <ECUC-NUMERICAL-PARAM-VALUE>
                                    <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/Pkg/ModDefs/Mod/Twin/Mark</DEFINITION-REF>
                                    <VALUE>1</VALUE>
                                </ECUC-NUMERICAL-PARAM-VALUE>
                            </PARAMETER-VALUES>
                            <SUB-CONTAINERS>
                                <ECUC-CONTAINER-VALUE>
                                    <SHORT-NAME>Leaf</SHORT-NAME>
                                    <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/Pkg/ModDefs/Mod/Leaf</DEFINITION-REF>
                                    <PARAMETER-VALUES>
                                        <ECUC-NUMERICAL-PARAM-VALUE>
                                            <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/Pkg/ModDefs/Mod/Leaf/Mark</DEFINITION-REF>
                                            <VALUE>11</VALUE>
                                        </ECUC-NUMERICAL-PARAM-VALUE>
                                    </PARAMETER-VALUES>
                                </ECUC-CONTAINER-VALUE>
                            </SUB-CONTAINERS>
                        </ECUC-CONTAINER-VALUE>
                        <ECUC-CONTAINER-VALUE>
                            <SHORT-NAME>Twin</SHORT-NAME>
                            <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/Pkg/ModDefs/Mod/Twin</DEFINITION-REF>
                            <PARAMETER-VALUES>
                                <ECUC-NUMERICAL-PARAM-VALUE>
                                    <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/Pkg/ModDefs/Mod/Twin/Mark</DEFINITION-REF>
                                    <VALUE>2</VALUE>
                                </ECUC-NUMERICAL-PARAM-VALUE>
                            </PARAMETER-VALUES>
                            <SUB-CONTAINERS>
                                <ECUC-CONTAINER-VALUE>
                                    <SHORT-NAME>Leaf</SHORT-NAME>
                                    <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/Pkg/ModDefs/Mod/Leaf</DEFINITION-REF>
                                    <PARAMETER-VALUES>
                                        <ECUC-NUMERICAL-PARAM-VALUE>
                                            <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/Pkg/ModDefs/Mod/Leaf/Mark</DEFINITION-REF>
                                            <VALUE>22</VALUE>
                                        </ECUC-NUMERICAL-PARAM-VALUE>
                                    </PARAMETER-VALUES>
                                </ECUC-CONTAINER-VALUE>
                            </SUB-CONTAINERS>
                        </ECUC-CONTAINER-VALUE>
                    </CONTAINERS>
                </ECUC-MODULE-CONFIGURATION-VALUES>
            </ELEMENTS>
        </AR-PACKAGE>
    </AR-PACKAGES>
</AUTOSAR>
