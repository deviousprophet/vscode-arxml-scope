<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic fixture: two sibling containers that share a SHORT-NAME, declared in the
     opposite order to the one `sort all` puts them in (the first declared has the
     lexically larger DEFINITION-REF). That is what makes "the ordinal comes from the
     raw model's document order, not the displayed order" falsifiable: an implementation
     that numbered the containers after ordering would swap the two ids, while this
     fixture's declaration order and its sorted order disagree. Never a real customer
     file. -->
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00048.xsd">
    <AR-PACKAGES>
        <AR-PACKAGE>
            <SHORT-NAME>Pkg</SHORT-NAME>
            <ELEMENTS>
                <ECUC-MODULE-CONFIGURATION-VALUES>
                    <SHORT-NAME>Mod</SHORT-NAME>
                    <DEFINITION-REF DEST="ECUC-MODULE-DEF">/Pkg/ModDefs/Mod</DEFINITION-REF>
                    <CONTAINERS>
                        <ECUC-CONTAINER-VALUE>
                            <SHORT-NAME>Twin</SHORT-NAME>
                            <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/Pkg/ModDefs/Mod/Zeta</DEFINITION-REF>
                            <PARAMETER-VALUES>
                                <ECUC-NUMERICAL-PARAM-VALUE>
                                    <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/Pkg/ModDefs/Mod/Zeta/Mark</DEFINITION-REF>
                                    <VALUE>1</VALUE>
                                </ECUC-NUMERICAL-PARAM-VALUE>
                            </PARAMETER-VALUES>
                        </ECUC-CONTAINER-VALUE>
                        <ECUC-CONTAINER-VALUE>
                            <SHORT-NAME>Twin</SHORT-NAME>
                            <DEFINITION-REF DEST="ECUC-PARAM-CONF-CONTAINER-DEF">/Pkg/ModDefs/Mod/Alpha</DEFINITION-REF>
                            <PARAMETER-VALUES>
                                <ECUC-NUMERICAL-PARAM-VALUE>
                                    <DEFINITION-REF DEST="ECUC-INTEGER-PARAM-DEF">/Pkg/ModDefs/Mod/Alpha/Mark</DEFINITION-REF>
                                    <VALUE>2</VALUE>
                                </ECUC-NUMERICAL-PARAM-VALUE>
                            </PARAMETER-VALUES>
                        </ECUC-CONTAINER-VALUE>
                    </CONTAINERS>
                </ECUC-MODULE-CONFIGURATION-VALUES>
            </ELEMENTS>
        </AR-PACKAGE>
    </AR-PACKAGES>
</AUTOSAR>
