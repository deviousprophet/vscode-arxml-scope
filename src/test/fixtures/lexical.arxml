<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE AUTOSAR [ <!ENTITY cdr "http://www.autosar.org/"> ]>
<AUTOSAR xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_00048.xsd">
  <!-- leading comment -->
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>P</SHORT-NAME>
      <ELEMENTS>
        <?pi between elements?>
        <ECUC-MODULE-CONFIGURATION-VALUES>
          <SHORT-NAME>M</SHORT-NAME>
          <DEFINITION-REF NOTE="a > b">/D/M</DEFINITION-REF>
          <CONTAINERS>
            <ECUC-CONTAINER-VALUE>
              <SHORT-NAME>C</SHORT-NAME>
              <DEFINITION-REF>/D/C</DEFINITION-REF>
              <PARAMETER-VALUES>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF>/D/C/Expr</DEFINITION-REF>
                  <VALUE><![CDATA[if a<b && c>d]]></VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-TEXTUAL-PARAM-VALUE>
                  <DEFINITION-REF>/D/C/Html</DEFINITION-REF>
                  <VALUE>&lt;b&gt;bold&lt;/b&gt; &amp; more</VALUE>
                </ECUC-TEXTUAL-PARAM-VALUE>
                <ECUC-NUMERICAL-PARAM-VALUE>
                  <DEFINITION-REF>/D/C/Empty</DEFINITION-REF>
                  <VALUE/>
                </ECUC-NUMERICAL-PARAM-VALUE>
              </PARAMETER-VALUES>
            </ECUC-CONTAINER-VALUE>
          </CONTAINERS>
        </ECUC-MODULE-CONFIGURATION-VALUES>
      </ELEMENTS>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
