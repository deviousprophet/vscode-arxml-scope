{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/test/**/*.test.ts",
    ".vscode-test.mjs",
    "esbuild.js",
    ".github/scripts/*.mjs",
    "scripts/*.js"
  ],
  "ignorePatterns": [
    ".opencode/**",
    ".agents/**",
    ".codegraph/**",
    ".fallow/**",
  ],
  "ignoreDependencies": [
    "@vscode/test-electron"
  ],
  "usedClassMembers": [
    {
      "implements": "vscode.CustomTextEditorProvider",
      "members": [
        "openCustomDocument",
        "resolveCustomEditor"
      ]
    }
  ]
}
