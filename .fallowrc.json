{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/webview/editorViewer.ts",
    "src/webview/editorMonaco.ts",
    "src/webview/diffMonaco.ts",
    "src/webview/monaco/worker.ts",
    "src/test/**/*.test.ts",
    "src/test/benchmarks/*.ts",
    "src/test/parity/oracle*.ts",
    ".vscode-test.mjs",
    "esbuild.js",
    ".github/scripts/*.mjs",
    "packages/webview-preview/adapters/arxml/index.mjs",
    "packages/webview-preview/adapters/toy/index.mjs",
    "packages/webview-preview/experiments/extensionHost/cdpCapture.mjs",
    "packages/webview-preview/experiments/extensionHost/run.mjs",
    "packages/webview-preview/experiments/extensionHost/suite.cjs",
    "packages/webview-preview/fixtures/toy/style.css"
  ],
  "ignorePatterns": [
    ".opencode/**",
    ".agents/**",
    ".codegraph/**",
    ".fallow/**"
  ],
  "ignoreDependencies": [
    "@vscode/test-electron"
  ],
  "dynamicallyLoaded": [
    "src/webview/styles/*.css"
  ],
  "usedClassMembers": [
    {
      "implements": "vscode.CustomTextEditorProvider",
      "members": [
        "openCustomDocument",
        "resolveCustomEditor"
      ]
    }
  ]
}
