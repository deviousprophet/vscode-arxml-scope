{
  "name": "vscode-arxml-scope",
  "displayName": "ARXML Scope",
  "description": "Browse and edit AUTOSAR ECUC-Values ARXML files in VS Code.",
  "version": "0.9.0",
  "publisher": "deviousprophet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deviousprophet/vscode-arxml-scope"
  },
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=24",
    "npm": ">=11"
  },
  "icon": "images/icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-arxml-scope.openEcucEditor",
        "title": "Open with ECUC Editor",
        "category": "ARXML Scope"
      },
      {
        "command": "vscode-arxml-scope.revealInSource",
        "title": "Reveal in ARXML Source",
        "category": "ARXML Scope"
      },
      {
        "command": "vscode-arxml-scope.revealInEcucEditor",
        "title": "Reveal in ECUC Editor",
        "category": "ARXML Scope"
      },
      {
        "command": "vscode-arxml-scope.selectAsFirst",
        "title": "Select as First File to Compare",
        "category": "ARXML Scope"
      },
      {
        "command": "vscode-arxml-scope.compareToStaged",
        "title": "Compare with First File",
        "category": "ARXML Scope"
      },
      {
        "command": "vscode-arxml-scope.compareSelected",
        "title": "Compare Two ARXML Files…",
        "category": "ARXML Scope"
      },
      {
        "command": "vscode-arxml-scope.rebuildIndex",
        "title": "Rebuild Workspace Index",
        "category": "ARXML Scope"
      },
      {
        "command": "vscode-arxml-scope.cycleCrossFileRules",
        "title": "Cycle Cross-File Checks",
        "category": "ARXML Scope"
      }
    ],
    "customEditors": [
      {
        "viewType": "vscode-arxml-scope.ecucEditor",
        "displayName": "ECUC Values Editor",
        "selector": [
          {
            "filenamePattern": "*.arxml"
          }
        ],
        "priority": "option"
      }
    ],
    "submenus": [
      {
        "id": "arxmlScope.actions",
        "label": "ARXML Scope"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "arxmlScope.actions",
          "when": "resourceExtname == .arxml",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "arxmlScope.actions",
          "when": "resourceExtname == .arxml && activeCustomEditorId != 'vscode-arxml-scope.ecucEditor'",
          "group": "navigation"
        }
      ],
      "arxmlScope.actions": [
        {
          "command": "vscode-arxml-scope.openEcucEditor",
          "when": "resourceExtname == .arxml",
          "group": "navigation"
        },
        {
          "command": "vscode-arxml-scope.revealInEcucEditor",
          "when": "resourceExtname == .arxml && activeCustomEditorId != 'vscode-arxml-scope.ecucEditor' && editorTextFocus",
          "group": "navigation"
        },
        {
          "command": "vscode-arxml-scope.selectAsFirst",
          "when": "resourceExtname == .arxml && !listMultiSelection && explorerViewletFocus",
          "group": "navigation"
        },
        {
          "command": "vscode-arxml-scope.compareToStaged",
          "when": "resourceExtname == .arxml && !listMultiSelection && explorerViewletFocus && arxmlScope.hasCompareSelection",
          "group": "navigation"
        },
        {
          "command": "vscode-arxml-scope.compareSelected",
          "when": "resourceExtname == .arxml && listDoubleSelection && explorerViewletFocus",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "ARXML Scope",
      "properties": {
        "arxmlScope.ecuc.editor.sort": {
          "type": "string",
          "enum": [
            "all",
            "declaration"
          ],
          "default": "all",
          "description": "Order of modules, containers, parameters and references in the ECUC editor. \"declaration\" keeps the file's own order."
        },
        "arxmlScope.ecuc.editor.sortExcept": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "DcmDspDidRef",
            "DcmDspRequestRoutineResultsOutSignal",
            "DcmDspStartRoutineInSignal",
            "DcmDspStartRoutineOutSignal",
            "DcmDspStopRoutineInSignal",
            "DcmDspStopRoutineOutSignal",
            "DcmArgumentRef",
            "DemDidDataElementClassRef",
            "DemExtendedDataRecordClassRef",
            "DemDataElementClassRef",
            "DemDidClassRef",
            "DemFreezeFrameRecordClassRef",
            "DemSPNClassRef",
            "EcuMDriverInitItem",
            "EcuMRbCallOutItem"
          ],
          "description": "DEFINITION-REF tails that keep declaration order under \"all\". Defaults to the list from the legacy Arxml2Artext.cmd."
        },
        "arxmlScope.ecuc.editor.revealMode": {
          "type": "string",
          "enum": [
            "beside",
            "focus",
            "replace"
          ],
          "default": "beside",
          "description": "Where \"Reveal in ARXML Source\" shows the file. \"beside\" opens the source next to the ECUC editor and keeps focus in the tree; \"focus\" opens it beside and moves focus there; \"replace\" swaps the ECUC editor's tab for the text editor, as older versions did."
        },
        "arxmlScope.index.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Index the workspace's .arxml files in memory so ECUC definitions resolve across files. The index is rebuilt on activation and follows file changes; nothing is written to disk."
        },
        "arxmlScope.index.maxFileSizeMB": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Largest .arxml file, in megabytes, that the workspace index reads. Larger files are skipped and reported in the status bar tooltip."
        },
        "arxmlScope.index.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace-relative globs that are never indexed, validated or used by navigation. Example: **/_fwd/**, **/_out/**, **/_gen/**."
        },
        "arxmlScope.validation.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Publish ECUC validation diagnostics to the Problems panel and the text editor."
        },
        "arxmlScope.validation.severities": {
          "type": "object",
          "default": {
            "brokenReference": "error",
            "destMismatch": "warning",
            "duplicateShortName": "error",
            "valueOutOfRange": "warning",
            "multiplicity": "warning",
            "missingDefinition": "information",
            "missingRequired": "warning"
          },
          "properties": {
            "brokenReference": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "information",
                "off"
              ],
              "description": "Reference target is missing or ambiguous."
            },
            "destMismatch": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "information",
                "off"
              ],
              "description": "A reference target is a different element kind than its DEST."
            },
            "duplicateShortName": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "information",
                "off"
              ],
              "description": "Two elements share one AR path."
            },
            "valueOutOfRange": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "information",
                "off"
              ],
              "description": "A parameter value is outside its definition's range or length."
            },
            "multiplicity": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "information",
                "off"
              ],
              "description": "A container, parameter or reference count is outside its definition's multiplicity."
            },
            "missingDefinition": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "information",
                "off"
              ],
              "description": "A DEFINITION-REF has no indexed definition."
            },
            "missingRequired": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "information",
                "off"
              ],
              "description": "A definition with a positive lower multiplicity has no instance."
            }
          },
          "description": "Per-rule severity for ECUC validation. Set a rule to \"off\" to hide it."
        },
        "arxmlScope.validation.maxDiagnosticsPerFile": {
          "type": "number",
          "default": 500,
          "minimum": 0,
          "description": "Maximum diagnostics published per file. Zero means unlimited; a summary diagnostic reports hidden problems."
        },
        "arxmlScope.validation.maxDiagnostics": {
          "type": "number",
          "default": 5000,
          "minimum": 0,
          "description": "Maximum diagnostics published for the workspace. Zero means unlimited; a summary diagnostic reports hidden problems."
        },
        "arxmlScope.validation.crossFileRules": {
          "type": "string",
          "enum": ["auto", "always", "never"],
          "default": "auto",
          "description": "When cross-file rules run. auto runs them only when the index has at least one ECUC definition; always reproduces the unconditional behaviour; never disables broken references, DEST mismatches and cross-file duplicate checks."
        },
        "arxmlScope.diff.semanticMatching": {
          "type": "boolean",
          "default": true,
          "description": "Pair renamed containers in the semantic diff. The diff toolbar can switch the current panel to Strict matching without changing this setting."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run rust:build && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run rust:build && npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "node eslint-rules/require-escaped-html.test.mjs && eslint src && npm run design:lint",
    "design:lint": "npx -y -p @google/design.md@0.4.0 designmd lint DESIGN.md",
    "test": "vscode-test",
    "benchmark": "node src/test/benchmarks/runBenchmark.ts",
    "parity": "node scripts/parity.mjs",
    "rust:build": "node scripts/build-rust-native.mjs",
    "rust:test": "cargo test --manifest-path rust/Cargo.toml --workspace",
    "rust:fmt": "cargo fmt --manifest-path rust/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets -- -D warnings",
    "rust:smoke": "node scripts/rust-smoke.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "jsdom": "^30.1.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.3",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1",
    "glob@>=9.0.0 <14.0.2": "^14.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
